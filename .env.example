# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# SMTP (Gmail + mot de passe d'application)
EMAIL_HOST_USER=ton.adresse@gmail.com
EMAIL_HOST_PASSWORD=ton-mot-de-passe-app
DEFAULT_FROM_EMAIL=ton.adresse@gmail.com

# Rappels pronos : heures avant le round (défaut 24,6). Mets 120 pour tester à 5 jours
REMINDER_HOURS=24,6

# Cron (obligatoire sur PythonAnywhere)
CRON_TOKEN=change-me-to-a-random-token

# TheSportsDB (gratuit, pour import auto des scores)
SPORTSDB_API_KEY=3
